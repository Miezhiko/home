conky.config = {
  own_window = true,
  own_window_transparent = true,
  own_window_type = 'normal',
  own_window_hints = 'undecorated,below,sticky,skip_taskbar,skip_pager',
  own_window_argb_visual = true,
  own_window_argb_value = 0,
  out_to_console = false,
  use_xft = true,
  font = 'Cantarell:size=11',
  update_interval = 2,
  cpu_avg_samples = 2,
  net_avg_samples = 2,
  double_buffer = true,
  maximum_width = 320,
  draw_shades = false,
  draw_outline = false,
  draw_borders = false,
  draw_graph_borders = false,
  stippled_borders = 1,
  border_width = 10,
  default_color = '#F5F5F5',
  default_shade_color = 'grey',
  default_outline_color = 'grey',
  alignment = 'top_right',
  gap_x = 10,
  gap_y = 10,
  use_spacer = 'left',
  no_buffers = true,
  uppercase = false
}

conky.text = [[
  ${alignc}${color}${execi 1000 cat /proc/cpuinfo | grep 'model name' | sed -e 's/model name.*: //'| uniq}
  ${alignc}${color #000000}${cpugraph 13,318 000000 33A3A3}
  ${color #C0C0C0}Total CPU Usage: ${color}${cpu cpu0}%${alignr}${color #C0C0C0}| ${color #C0C0C0}CPU Temperature: ${color}${hwmon temp 1}°C

  ${color #C0C0C0}C1: ${color}${cpu cpu1}% ${color #C0C0C0}@ ${color}${freq 1} MHz${color #33A3A3}${alignr}${color #C0C0C0}C2: ${color}${cpu cpu2}% ${color #C0C0C0}@ ${color}${freq 2} MHz   
  ${color #33A3A3}${cpubar cpu1 6,150}${alignr}${color #33A3A3}${cpubar cpu2 6,150}
  ${color #C0C0C0}C3: ${color}${cpu cpu3}% ${color #C0C0C0}@ ${color}${freq 3} MHz${color #33A3A3}${alignr}${color #C0C0C0}C4: ${color}${cpu cpu4}% ${color #C0C0C0}@ ${color}${freq 4} MHz   
  ${color #33A3A3}${cpubar cpu3 6,150}${alignr}${color #33A3A3}${cpubar cpu4 6,150}
  ${color #C0C0C0}C5: ${color}${cpu cpu5}% ${color #C0C0C0}@ ${color}${freq 5} MHz${color #33A3A3}${alignr}${color #C0C0C0}C6: ${color}${cpu cpu6}% ${color #C0C0C0}@ ${color}${freq 6} MHz   
  ${color #33A3A3}${cpubar cpu5 6,150}${alignr}${color #33A3A3}${cpubar cpu6 6,150}
  ${color #C0C0C0}C7: ${color}${cpu cpu7}% ${color #C0C0C0}@ ${color}${freq 7} MHz${color #33A3A3}${alignr}${color #C0C0C0}C8: ${color}${cpu cpu8}% ${color #C0C0C0}@ ${color}${freq 8} MHz   
  ${color #33A3A3}${cpubar cpu7 6,150}${alignr}${color #33A3A3}${cpubar cpu8 6,150}
  ${color #656565}$stippled_hr$color

  ${color #C0C0C0}Ram  ${alignc}               ${color}$mem${color #C0C0C0} / ${color}$memmax ${alignr}${memperc}% Used
  ${color #33A3A3}${membar 6,318}
  ${color #C0C0C0}Swap ${alignc}                 ${color}${swap}${color #C0C0C0} / ${color}${swapmax} ${alignr}${swapperc}% Used
  ${color #33A3A3}${swapbar 6,318}
  ${color #C0C0C0}$fs_type ${alignc}               ${color}${fs_used}${color #C0C0C0} / ${color}${fs_size} ${alignr}${fs_used_perc /}% Used
  ${color #33A3A3}${fs_bar 6,318 /}
  ${color #C0C0C0}$fs_type ${alignc}               ${color}${fs_used /data2}${color #C0C0C0} /data2 ${color}${fs_size /data2} ${alignr}${fs_used_perc /data2}% Used
  ${color #33A3A3}${fs_bar 6,318 /data2}
  ${color #C0C0C0}Disk Read IO: $color${diskio_read}${alignr}${color #C0C0C0}Disk Write IO: ${color}${diskio_write}
  ${color #000000}${diskiograph_read 12,145 000000 33A3A3}${alignr}${color #000000}${diskiograph_write 12,145 000000 33A3A3}
  ${color #C0C0C0}Processes: ${color}$running_processes${color #C0C0C0} / ${color}$processes${alignr}${color #C0C0C0}Threads: ${color}$running_threads${color #C0C0C0} / ${color}$threads
  ${color #656565}$stippled_hr$color
  ${color #C0C0C0} Top CPU${alignr}CPU 
  ${color}${top name 1}$alignr${top cpu 1}%
  ${color}${top name 2}$alignr${top cpu 2}%
  ${color}${top name 3}$alignr${top cpu 3}%
  ${color}${top name 4}$alignr${top cpu 4}%
  ${color}${top name 5}$alignr${top cpu 5}%
#  ${color}${top name 6}$alignr${top cpu 6}%
#  ${color}${top name 7}$alignr${top cpu 7}%
#  ${color}${top name 8}$alignr${top cpu 8}%
  ${color #656565}$stippled_hr$color
  ${color #C0C0C0} Top Memory${alignr}Memory    CPU 
  ${color}${top_mem name 1}${alignr}${top_mem mem_res 1}$alignr${top_mem cpu 1}%
  ${color}${top_mem name 2}${alignr}${top_mem mem_res 2}$alignr${top_mem cpu 2}%
  ${color}${top_mem name 3}${alignr}${top_mem mem_res 3}$alignr${top_mem cpu 3}%
  ${color}${top_mem name 4}${alignr}${top_mem mem_res 4}$alignr${top_mem cpu 4}%
  ${color}${top_mem name 5}${alignr}${top_mem mem_res 5}$alignr${top_mem cpu 5}%
  ${color}${top_mem name 6}${alignr}${top_mem mem_res 6}$alignr${top_mem cpu 6}%
#  ${color}${top_mem name 7}${alignr}${top_mem mem_res 7}$alignr${top_mem cpu 7}%
#  ${color}${top_mem name 8}${alignr}${top_mem mem_res 8}$alignr${top_mem cpu 8}%
#  ${color}${top_mem name 9}${alignr}${top_mem mem_res 9}$alignr${top_mem cpu 9}%
#  ${color}${top_mem name 10}${alignr}${top_mem mem_res 10}$alignr${top_mem cpu 10}%
  ${color #656565}$stippled_hr$color
  ${color #C0C0C0} Ticker USDT${alignr}Graph 
  ${color}BTC ${alignr}${color}${execpi 30 grep -oP '(?<=^)[+-]?\d*\.?\d+' /data2/contrib/haskell/bb/BTCUSDT | awk '{print $1 < 0 ? "${color FF9999}" substr($0, 2) : "${color 99FF99}" substr($0, 2)}'} ${color}${execgraph "cat /data2/contrib/haskell/bb/BTCUSDT | awk '{print (substr($0,2) - 58000) / 100}'" 17,210 C0C0C0 EAEAEA -lt}
  ${color}ETH ${alignr}${color}${execpi 30 grep -oP '(?<=^)[+-]?\d*\.?\d+' /data2/contrib/haskell/bb/ETHUSDT | awk '{print $1 < 0 ? "${color FF9999}" substr($0, 2) : "${color 99FF99}" substr($0, 2)}'} ${color}${execgraph "cat /data2/contrib/haskell/bb/ETHUSDT | awk '{print (substr($0,2) - 2700) / 18}'" 17,210 C0C0C0 EAEAEA -lt}
  ${color}SOL ${alignr}${color}${execpi 30 grep -oP '(?<=^)[+-]?\d*\.?\d+' /data2/contrib/haskell/bb/SOLUSDT | awk '{print $1 < 0 ? "${color FF9999}" substr($0, 2) : "${color 99FF99}" substr($0, 2)}'} ${color}${execgraph "cat /data2/contrib/haskell/bb/SOLUSDT | awk '{print (substr($0,2) - 125) * 1.5}'" 17,210 C0C0C0 EAEAEA -lt}

  ${voffset 4}${color4}NETWORK${offset 8}${color8}${voffset -2}${hr 2}
  ${voffset 4}${color6}T${color3}${offset 5}Download${goto 120}${totaldown enp4s0}${alignr}${downspeed enp4s0}
  ${voffset 0}N${color3}${offset 5}Upload${goto 120}${totalup enp4s0}${alignr}${upspeed enp4s0}

  ${color}${kernel}$alignr${color}uptime ${uptime_short}
]]
