{
  "features": {
    "edit_prediction_provider": "zed"
  },
  "agent": {
    "model_parameters": [],
    "default_model": {
      "provider": "ollama",
      "model": "deepseek-r1:latest"
    },
    "version": "2"
  },
  "settings": {
    "minimap": true
  },
  "minimap": {
    "show": "always",
    "thumb": "always",
    "thumb_border": "left_open",
    "current_line_highlight": "line"
  },
  "languages": {
    "Haskell": {
      "formatter": {
        "external": {
          "command": "stylish-haskell",
          "arguments": ["{buffer_path}"]
        }
      }
    }
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "ui_font_size": 15,
  "buffer_font_size": 15,
  "ui_font_family": "Hasklig",
  "buffer_font_family": "Hasklig",
  "theme": {
    "mode": "dark",
    "light": "One Dark",
    "dark": "Miezhiko theme"
  }
}
