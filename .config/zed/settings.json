{
  "project_panel": {
    "dock": "left"
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "git_panel": {
    "dock": "left"
  },
  "show_edit_predictions": false,
  "features": {
    "edit_prediction_provider": "zed"
  },
  "agent": {
    "dock": "right",
    "model_parameters": [],
    "default_model": {
      "provider": "ollama",
      "model": "qwen2.5-coder:latest"
    },
  },
  "settings": {
    "minimap": true
  },
  "minimap": {
    "show": "always",
    "thumb": "always",
    "thumb_border": "left_open",
    "current_line_highlight": "line"
  },
  "languages": {
    "Rust": {
      "show_edit_predictions": false,
      "tab_size": 2
    },
    "Haskell": {
      "tab_size": 2
      /*
      "formatter": {
        "external": {
          "command": "stylish-haskell",
          "arguments": ["{buffer_path}"]
        }
      }*/
    }
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "ui_font_size": 15,
  "buffer_font_size": 15,
  "ui_font_family": "Hasklig",
  "buffer_font_family": "Hasklig",
  "theme": {
    "mode": "dark",
    "light": "One Dark",
    "dark": "Ayu Mirage"
  }
}
